---
/**
 * Elevaciones técnicas de los cuatro conjuntos del tren de rodaje.
 * Dibujo propio, no fotografía de catálogo ajeno: contorno en oro,
 * líneas de construcción y ejes en gris, como en un plano de taller.
 */
import type { PartName } from '../../data/components';

interface Props {
  name: PartName;
  class?: string;
}

const { name, class: className = '' } = Astro.props;

const SPROCKET_TEETH =
  'M 91.23 32.57 L 94.47 12.17 A 88 88 0 0 1 105.53 12.17 L 108.77 32.57 A 68 68 0 0 1 116.18 33.95 L 126.57 16.11 A 88 88 0 0 1 136.88 20.1 L 132.54 40.29 A 68 68 0 0 1 138.95 44.26 L 155.08 31.37 A 88 88 0 0 1 163.25 38.82 L 151.91 56.08 A 68 68 0 0 1 156.45 62.09 L 176.16 55.91 A 88 88 0 0 1 181.08 65.8 L 164.27 77.8 A 68 68 0 0 1 166.33 85.04 L 186.94 86.39 A 88 88 0 0 1 187.96 97.4 L 167.95 102.51 A 68 68 0 0 1 167.26 110.02 L 185.99 118.72 A 88 88 0 0 1 182.96 129.35 L 162.46 126.89 A 68 68 0 0 1 159.1 133.64 L 173.42 148.52 A 88 88 0 0 1 166.76 157.34 L 148.53 147.64 A 68 68 0 0 1 142.96 152.71 L 150.93 171.76 A 88 88 0 0 1 141.54 177.58 L 128.04 161.95 A 68 68 0 0 1 121.01 164.67 L 121.57 185.32 A 88 88 0 0 1 110.71 187.35 L 103.77 167.9 A 68 68 0 0 1 96.23 167.9 L 89.29 187.35 A 88 88 0 0 1 78.43 185.32 L 78.99 164.67 A 68 68 0 0 1 71.96 161.95 L 58.46 177.58 A 88 88 0 0 1 49.07 171.76 L 57.04 152.71 A 68 68 0 0 1 51.47 147.64 L 33.24 157.34 A 88 88 0 0 1 26.58 148.52 L 40.9 133.64 A 68 68 0 0 1 37.54 126.89 L 17.04 129.35 A 88 88 0 0 1 14.01 118.72 L 32.74 110.02 A 68 68 0 0 1 32.05 102.51 L 12.04 97.4 A 88 88 0 0 1 13.06 86.39 L 33.67 85.04 A 68 68 0 0 1 35.73 77.8 L 18.92 65.8 A 88 88 0 0 1 23.84 55.91 L 43.55 62.09 A 68 68 0 0 1 48.09 56.08 L 36.75 38.82 A 88 88 0 0 1 44.92 31.37 L 61.05 44.26 A 68 68 0 0 1 67.46 40.29 L 63.12 20.1 A 88 88 0 0 1 73.43 16.11 L 83.82 33.95 A 68 68 0 0 1 91.23 32.57 Z';

const SPROCKET_BOLTS: [number, number][] = [
  [100, 56],
  [138.11, 78],
  [138.11, 122],
  [100, 144],
  [61.89, 122],
  [61.89, 78],
];

const IDLER_BOLTS: [number, number][] = [
  [100, 62],
  [126.87, 73.13],
  [138, 100],
  [126.87, 126.87],
  [100, 138],
  [73.13, 126.87],
  [62, 100],
  [73.13, 73.13],
];

// Garras de la zapata, repartidas a lo largo de la placa
const GROUSERS = [46, 100, 154];
---

<svg
  class={className}
  viewBox="0 0 200 200"
  fill="none"
  aria-hidden="true"
  focusable="false"
  stroke-linecap="square"
  stroke-linejoin="miter"
>
  <g
    stroke="currentColor"
    stroke-width="1"
    opacity="0.28"
    stroke-dasharray="7 4 2 4"
  >
    <path d="M100 4V196" />
    <path d="M4 100H196" />
  </g>

  {
    name === 'sprocket' && (
      <g>
        <path
          d={SPROCKET_TEETH}
          stroke="currentColor"
          stroke-width="2.25"
          opacity="0.95"
        />
        <circle cx="100" cy="100" r="58" stroke="currentColor" stroke-width="1.25" opacity="0.5" />
        <circle cx="100" cy="100" r="30" stroke="currentColor" stroke-width="2.25" opacity="0.95" />
        <circle cx="100" cy="100" r="17" stroke="currentColor" stroke-width="1.25" opacity="0.5" />
        <circle
          cx="100"
          cy="100"
          r="44"
          stroke="currentColor"
          stroke-width="1"
          opacity="0.25"
          stroke-dasharray="6 5"
        />
        {SPROCKET_BOLTS.map(([x, y]) => (
          <circle cx={x} cy={y} r="5.5" stroke="currentColor" stroke-width="1.5" opacity="0.7" />
        ))}
      </g>
    )
  }

  {
    name === 'idler' && (
      <g>
        <circle cx="100" cy="100" r="88" stroke="currentColor" stroke-width="2.25" opacity="0.95" />
        <circle cx="100" cy="100" r="79" stroke="currentColor" stroke-width="1.25" opacity="0.55" />
        <circle cx="100" cy="100" r="70" stroke="currentColor" stroke-width="2.25" opacity="0.95" />
        {/* Pestaña central de guía */}
        <circle cx="100" cy="100" r="50" stroke="currentColor" stroke-width="1.25" opacity="0.45" />
        <circle cx="100" cy="100" r="26" stroke="currentColor" stroke-width="2.25" opacity="0.95" />
        <circle cx="100" cy="100" r="14" stroke="currentColor" stroke-width="1.25" opacity="0.5" />
        {IDLER_BOLTS.map(([x, y]) => (
          <circle cx={x} cy={y} r="4" stroke="currentColor" stroke-width="1.5" opacity="0.65" />
        ))}
        {/* Sectores de la banda de rodadura */}
        <g stroke="currentColor" stroke-width="1" opacity="0.4">
          <path d="M100 12V30" />
          <path d="M100 170v18" />
          <path d="M12 100h18" />
          <path d="M170 100h18" />
        </g>
      </g>
    )
  }

  {
    name === 'roller' && (
      <g>
        {/* Eje pasante */}
        <path d="M4 88h192v24H4z" stroke="currentColor" stroke-width="1.25" opacity="0.55" />
        {/* Cuerpo del rodillo */}
        <path d="M40 48h120v104H40z" stroke="currentColor" stroke-width="2.25" opacity="0.95" />
        {/* Pestañas de guía */}
        <path d="M40 26h22v148H40z" stroke="currentColor" stroke-width="2.25" opacity="0.95" />
        <path d="M138 26h22v148h-22z" stroke="currentColor" stroke-width="2.25" opacity="0.95" />
        {/* Sellos y casquillos */}
        <g stroke="currentColor" stroke-width="1.25" opacity="0.5">
          <path d="M74 48v104M126 48v104" />
          <path d="M62 66h76M62 134h76" />
        </g>
        {/* Extremos del eje */}
        <g stroke="currentColor" stroke-width="1.5" opacity="0.7">
          <path d="M14 74h18v52H14z" />
          <path d="M168 74h18v52h-18z" />
        </g>
      </g>
    )
  }

  {
    name === 'shoe' && (
      <g>
        {/* Cuerpo del eslabón */}
        <path
          d="M28 106V44a16 16 0 0 1 16-16h112a16 16 0 0 1 16 16v62"
          stroke="currentColor"
          stroke-width="2.25"
          opacity="0.95"
        />
        {/* Alojamientos de pasador */}
        <circle cx="60" cy="66" r="21" stroke="currentColor" stroke-width="2.25" opacity="0.95" />
        <circle cx="60" cy="66" r="10" stroke="currentColor" stroke-width="1.25" opacity="0.5" />
        <circle cx="140" cy="66" r="21" stroke="currentColor" stroke-width="2.25" opacity="0.95" />
        <circle cx="140" cy="66" r="10" stroke="currentColor" stroke-width="1.25" opacity="0.5" />
        {/* Placa de oruga */}
        <path d="M8 106h184v30H8z" stroke="currentColor" stroke-width="2.25" opacity="0.95" />
        {/* Garras */}
        {GROUSERS.map((x) => (
          <path
            d={`M${x - 17} 136h34l-7 46h-20z`}
            stroke="currentColor"
            stroke-width="2.25"
            opacity="0.95"
          />
        ))}
        {/* Tornillería de fijación */}
        <g stroke="currentColor" stroke-width="1.5" opacity="0.6">
          <path d="M22 113h14v16H22zM164 113h14v16h-14z" />
        </g>
      </g>
    )
  }
</svg>
