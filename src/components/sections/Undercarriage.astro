---
import { productComponents } from "../../data/components";
import Icon from "../ui/Icon.astro";
---

<section
  class="w-full bg-navy py-section-gap md:py-section-gap-lg"
  id="undercarriage"
  data-nav-section
>
  <div
    class="mx-auto max-w-container-max px-margin-mobile md:px-margin-desktop"
  >
    <div
      class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between"
    >
      <div class="max-w-3xl">
        <h2 class="t-h2 text-bone">Tren de rodaje para gran minería</h2>
        <p class="t-lead mt-5 max-w-measure">
          Cuatro conjuntos fabricados bajo las mismas normas, con la
          intercambiabilidad que su máquina exige y condiciones de garantía
          superiores.
        </p>
      </div>
      <a
        class="btn btn-ghost group shrink-0 sm:self-start"
        href="/cotizar?servicio=tren-de-rodaje"
      >
        Reservar supervisión
        <Icon
          name="arrow-right"
          size={16}
          class="transition-transform duration-300 ease-out group-hover:translate-x-1"
        />
      </a>
    </div>

    <div
      class="mt-12 grid grid-cols-1 gap-px bg-navy-500/60 md:mt-14 lg:grid-cols-2"
    >
      {
        productComponents.map((component) => (
          <article class="group flex flex-col gap-6 bg-navy-700 p-7 sm:flex-row sm:gap-8 sm:p-9">
            {/* El render viene recortado sobre transparencia: la sombra sigue
                el contorno real de la pieza y la asienta sobre el panel. */}
            <div class="flex h-32 w-full shrink-0 items-center justify-center sm:h-40 sm:w-48">
              <img
                class="h-full w-full object-contain object-center drop-shadow-[0_16px_22px_rgba(1,12,22,0.7)] transition-transform duration-700 ease-out group-hover:-translate-y-1 group-hover:scale-[1.04]"
                src={component.image}
                alt={component.imageAlt}
                width={component.imageWidth}
                height={component.imageHeight}
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="min-w-0">
              <h3 class="t-h3 text-bone">{component.title}</h3>
              <p class="t-data mt-2 text-gold">{component.spec}</p>
              <p class="t-small mt-4 text-smoke">{component.lead}</p>
              <p class="t-small mt-3 text-grit">{component.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
